---
import type { Pergunta } from "../data/tipos";

interface Props {
  perguntas: Pergunta[];
  titulo?: string;
  id?: string;
}

const { perguntas, titulo = "Perguntas frequentes", id = "perguntas" } = Astro.props;
---

<div class="faq">
  <h2 id={id}>{titulo}</h2>
  {
    perguntas.map((p) => (
      <details>
        <summary>{p.pergunta}</summary>
        <p set:html={p.resposta} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    max-width: 760px;
  }

  details {
    border-bottom: 1px solid var(--linha);
  }

  details:first-of-type {
    border-top: 1px solid var(--linha);
  }

  summary {
    position: relative;
    padding: 16px 40px 16px 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--marca);
  }

  details[open] summary::after {
    content: "−";
  }

  details p {
    margin: 0 0 18px;
    color: var(--tinta-suave);
  }
</style>
