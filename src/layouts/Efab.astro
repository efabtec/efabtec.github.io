---
import "@fontsource-variable/figtree";
import "../themes/gerado/efab.css";
import Base from "./Base.astro";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import { jsonldEfab } from "../data/jsonld";

interface Props {
  titulo: string;
  descricao?: string;
  /** href da página atual no menu. */
  atual?: string;
}

const { titulo, descricao, atual } = Astro.props;
const links = [
  { rotulo: "Aplicativos", href: "/#apps" },
  { rotulo: "Sobre", href: "/sobre.html" },
  { rotulo: "Contato", href: "/#contato" },
];
---

<Base
  titulo={titulo}
  descricao={descricao}
  tema="efab"
  favicon="/favicon.svg"
  imagem="/og/efab.png"
  jsonld={atual === undefined ? jsonldEfab : undefined}
>
  <Cabecalho nome="EFAB" sobrenome="Tecnologia" href="/" links={links} atual={atual} />
  <main>
    <slot />
  </main>
  <Rodape />
</Base>
